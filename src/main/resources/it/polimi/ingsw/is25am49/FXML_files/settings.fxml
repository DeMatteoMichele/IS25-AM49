<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<StackPane fx:id="Stack" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.is25am49.client.GUI.settingsController">
   <children>
      <ImageView fx:id="backgroundImage" pickOnBounds="true">
      </ImageView>


      <Pane prefHeight="595.0" prefWidth="686.0">
         <children>
            <Button fx:id="yesReconnection" layoutX="393.0" layoutY="92.0" mnemonicParsing="false" onAction="#handleReconnection" text="YES">

            </Button>
            <Label contentDisplay="BOTTOM" layoutX="10.0" layoutY="87.0" prefHeight="33.0" prefWidth="283.0" text="Do you want to reconnect to a previous game?" textAlignment="CENTER">
               <cursor>
                  <Cursor fx:constant="CROSSHAIR" />
               </cursor>
               <effect>
                  <Lighting bumpInput="$null">
                     <light>
                        <Light.Distant />
                     </light>
                  </Lighting>
               </effect>
            </Label>
            <Button fx:id="noReconnection" layoutX="393.0" layoutY="138.0" mnemonicParsing="false" onAction="#disableReconnectionButtons" text="NO" />
            <Label fx:id="usernameLabel" layoutX="24.0" layoutY="226.0" prefHeight="17.0" prefWidth="270.0" text="Please insert your username: " />
            <TextField fx:id="usernameTextField" layoutX="298.0" layoutY="222.0" prefHeight="25.0" prefWidth="260.0" />
            <Button fx:id="usernameButton" layoutX="586.0" layoutY="222.0" mnemonicParsing="false" onAction="#handleUsername" prefHeight="25.0" prefWidth="86.0" text="CONFIRM" />
            <Label layoutX="24.0" layoutY="333.0" prefHeight="17.0" prefWidth="206.0" text="Choose the connection method" />
            <Button fx:id="rmiButton" layoutX="411.0" layoutY="329.0" mnemonicParsing="false" onAction="#handleRMI" text="RMI" />
            <Button fx:id="socketButton" layoutX="393.0" layoutY="371.0" mnemonicParsing="false" onAction="#handleSocket" prefHeight="25.0" prefWidth="86.0" text="SOCKET" />
            <Label fx:id="retryLabel" layoutX="33.0" layoutY="464.0" text="CONNECTION FAILED! Do you want to retry?" />
            <Button fx:id="yesRetry" layoutX="332.0" onAction="#yesRetry" layoutY="452.0" mnemonicParsing="false" text="YES" />
            <Button fx:id="noRetry" layoutX="332.0" onAction="#noRetry" layoutY="491.0" mnemonicParsing="false" text="NO" />
         </children></Pane>




   </children>
</StackPane>
