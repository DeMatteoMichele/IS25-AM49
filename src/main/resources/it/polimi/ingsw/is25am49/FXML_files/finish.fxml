<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.is25am49.client.GUI.finishController">
   <children>
      <ImageView fx:id="backgroundImage" pickOnBounds="true" />

 <!-- Podio con posizioni -->
      <StackPane maxHeight="830.0" maxWidth="1200.0" minHeight="830.0" minWidth="1200.0">
    <children>
       <ImageView fx:id="podio" fitHeight="830.0" fitWidth="1200.0" pickOnBounds="true" preserveRatio="true">
          <image>
             <Image url="@/podium.png" />
          </image>
       </ImageView>

       <AnchorPane fx:id="podioAnchorPane" prefHeight="830.0" prefWidth="1200.0">
          <children>
           <Label fx:id="firstPosition" prefHeight="69.0" prefWidth="172.0" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #ffd700; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.7), 3, 0, 0, 2); -fx-font-family: 'Impact';" AnchorPane.leftAnchor="520.0" AnchorPane.topAnchor="200.0" />
             <Label fx:id="secondPosition" prefHeight="30.0" prefWidth="195.0" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #c0c0c0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.7), 3, 0, 0, 2); -fx-font-family: 'Impact';" AnchorPane.leftAnchor="390.0" AnchorPane.topAnchor="235.0" />
             <Label fx:id="thirdPosition" prefHeight="30.0" prefWidth="100.0" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #cd7f32; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.7), 3, 0, 0, 2); -fx-font-family: 'Impact';" AnchorPane.leftAnchor="690.0" AnchorPane.topAnchor="285.0" />
             <Label fx:id="fourthPosition" prefHeight="30.0" prefWidth="100.0" rotate="-25" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #4169e1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.7), 3, 0, 0, 2); -fx-font-family: 'Impact';" AnchorPane.leftAnchor="830.0" AnchorPane.topAnchor="150.0" />
          </children>
       </AnchorPane>
    </children>
 </StackPane>

      <HBox alignment="TOP_CENTER" spacing="40.0" style="-fx-padding: 20px 0 0 0;">
         <children>
           <Button fx:id="endGame" mnemonicParsing="false" onAction="#endGame" prefHeight="25.0" prefWidth="150.0" style="-fx-background-color: rgba(0,20,40,0.7); -fx-background-radius: 10; -fx-border-color: linear-gradient(to right, #5e60ce, #64dfdf); -fx-border-width: 2; -fx-border-radius: 10; -fx-text-fill: #ffffff; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 5 10 5 10; -fx-alignment: center; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 5, 0, 0, 3);" text="END GAME" />
             <Label fx:id="gameFinished" style="-fx-background-color: rgba(0,20,40,0.7); -fx-background-radius: 10; -fx-border-color: linear-gradient(to right, #5e60ce, #64dfdf); -fx-border-width: 2; -fx-border-radius: 10; -fx-text-fill: #ffffff; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 5 10 5 10; -fx-alignment: center; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 5, 0, 0, 3);" text="GAME FINISHED! THANKS FOR PLAYING" />
           <Button fx:id="calculateScore" mnemonicParsing="false" onAction="#calculateScore" prefHeight="31.0" prefWidth="194.0" style="-fx-background-color: rgba(0,20,40,0.7); -fx-background-radius: 10; -fx-border-color: linear-gradient(to right, #5e60ce, #64dfdf); -fx-border-width: 2; -fx-border-radius: 10; -fx-text-fill: #ffffff; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 5 10 5 10; -fx-alignment: center; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 5, 0, 0, 3);" text="CALCULATE SCORE" />
         </children>
      </HBox>
   </children>
</StackPane>
